# Copie este arquivo para ".env" e preencha com os valores reais.
# Nao versione o arquivo ".env" (ja esta no .gitignore).

# URL do Web App publicado do Google Apps Script (termina em /exec)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_ID_AQUI/exec

# Mesmo token definido na constante TOKEN em apps-script/Code.js
VITE_API_TOKEN=TROQUE-ESTE-TOKEN
